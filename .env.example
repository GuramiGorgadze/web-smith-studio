# Copy to .env and edit. All values are optional.
# These settings are for the website (the Vite build). The mail server has its own file: server/.env.example

# Public address of the deployed site, no trailing path. Used for canonical links, social-share tags,
# sitemap.xml and robots.txt. Set it before you run the production build.
VITE_SITE_URL=https://your-domain.com

# The address shown on the site, and where inquiries go when no form endpoint is configured
# (the visitor's mail app opens instead).
VITE_CONTACT_EMAIL=hello@your-domain.com

# The language of the plain addresses (https://your-domain.com/work). The other language lives under its code
# (https://your-domain.com/ka/work). Use "en" or "ka"; anything else means "en". Visitors can always switch.
VITE_DEFAULT_LOCALE=en

# Where the contact form sends inquiries.
#   /api/contact   our own Node mail server in server/ (Nodemailer). In development Vite passes the request on
#                  to it, so run `npm run server:dev` in a second terminal. When one server hosts both the
#                  site and the API, this is also the right value for production.
#   a full URL     a form service (Formspree, Getform, Basin ...) or the mail server on another address,
#                  for example https://api.your-domain.com/api/contact (then set CORS_ORIGIN in server/.env).
#   empty          no server: the visitor's mail app opens with the message prefilled.
VITE_FORM_ENDPOINT=/api/contact

# Development only: where Vite sends /api requests. The default matches the server's default port.
# VITE_API_PROXY=http://127.0.0.1:8787

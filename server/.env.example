# Web Smith Studio mail server: settings
#
# Copy this file to `.env` (in this folder, next to package.json) and edit it. Every line is optional.
# With no changes at all the server starts in PREVIEW mode: it builds the real emails and saves them as
# files in server/.previews instead of sending them, so you can see and test everything first.
#
# Real settings from the host (Docker, Render, Railway, a VPS ...) always win over this file.


# ── Where the website lives ───────────────────────────────────────────────────

# The public address of the website, no path. It becomes the "See our work" link in the confirmation
# email and the one address that browsers may call this API from.
SITE_URL=https://your-domain.com

# Used in email subjects and sender names.
SITE_NAME=Web Smith Studio

# Language of the site at its plain address: "en" (then Georgian lives under /ka) or "ka".
# Keep it the same as DEFAULT_LOCALE in the website.
DEFAULT_LOCALE=en


# ── Who gets the mail ─────────────────────────────────────────────────────────

# The inbox that receives every inquiry. Several addresses can be separated with commas.
MAIL_TO=you@your-domain.com

# The address the emails are sent from. It must be an address your SMTP account is allowed to send from.
# Visitors never see it as a place to reply: replies go to the visitor (notification) or to MAIL_TO (confirmation).
# Both forms work:  no-reply@your-domain.com   or   Web Smith Studio <no-reply@your-domain.com>
MAIL_FROM=Web Smith Studio <no-reply@your-domain.com>

# The language YOU read the notification emails in: "en" or "ka".
STUDIO_LOCALE=en

# Your time zone, so "received at" in the notification is your local time. Examples: Asia/Tbilisi, Europe/London, UTC.
TIMEZONE=Asia/Tbilisi


# ── The SMTP account that sends the mail ──────────────────────────────────────
#
# Leave SMTP_HOST empty (or commented out) to stay in PREVIEW mode. Fill it in to send real email.
# Run `npm run send:test` in this folder afterwards to check the login and send yourself a test.
#
# Ports: 587 uses STARTTLS (the usual choice, and the default), 465 is an always-encrypted connection.
# The password is never printed in logs.
#
# Gmail (needs 2-Step Verification, then an "App password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your-name@gmail.com
#   SMTP_PASS=the 16-letter app password
#   MAIL_FROM=your-name@gmail.com        (Gmail always sends as the logged-in address)
#
# Other providers (check their pages for the exact host and a sending password or API key):
#   Brevo          smtp-relay.brevo.com   587
#   Mailgun        smtp.mailgun.org       587
#   Resend         smtp.resend.com        465   (user: resend, password: your API key)
#   Postmark       smtp.postmarkapp.com   587
#   Zoho Mail      smtp.zoho.com          465
#   Your hosting   mail.your-domain.com   587   (a mailbox you created in the hosting panel)
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Rarely needed. SMTP_SECURE defaults to true only for port 465. SMTP_REQUIRE_TLS defaults to true for every
# connection that is not encrypted from the start and not to this very machine, so passwords and messages are
# never sent in the clear.
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true

# "smtp" sends real email, "preview" only saves files. When left out it is "smtp" if SMTP_HOST is set.
# MAIL_MODE=preview


# ── The confirmation email to the visitor ─────────────────────────────────────

# Send a short, designed "we got your message" email to the visitor. true or false.
AUTO_REPLY=true

# The promise in that email and on the thank-you screen, in English and in Georgian.
RESPONSE_TIME=within one business day
RESPONSE_TIME_KA=ერთი სამუშაო დღის განმავლობაში

# At most this many confirmations go to one address per window, so the form can never be used to flood
# someone's inbox. Your own notification email is never limited this way.
AUTO_REPLY_MAX_PER_EMAIL=3
AUTO_REPLY_WINDOW_HOURS=24


# ── Protection against abuse ──────────────────────────────────────────────────

# At most RATE_LIMIT_MAX inquiries per visitor address in this many minutes.
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MINUTES=15

# Other websites that may call the API from a browser, separated by commas. Leave it out and the server allows
# SITE_URL (plus localhost while developing). Needed only when the site and this server live on different addresses.
# CORS_ORIGIN=https://your-domain.com,https://www.your-domain.com

# Only when this server sits behind a proxy or load balancer (Nginx, Render, Railway, Fly, Cloudflare ...).
# Without this, every visitor looks like the proxy and shares one rate limit. Use the number of proxies
# in front of the server (usually 1), or true when you are not sure it is just one. Leave it at false when
# visitors connect straight to this server.
TRUST_PROXY=false


# ── Running the server ────────────────────────────────────────────────────────

# development (pretty logs, localhost allowed) or production (JSON logs, https only, strict).
NODE_ENV=development

PORT=8787
HOST=0.0.0.0

# debug, info, warn, error or silent.
# LOG_LEVEL=info

# Serve the built website (the dist folder) from this same server, so one program runs everything.
# "auto" does it when a build exists. Build the website first with `npm run build` in the project root.
SERVE_STATIC=auto
STATIC_DIR=../dist

# Where PREVIEW mode saves its files.
PREVIEW_DIR=.previews

{
  "name": "web-smith-studio-server",
  "version": "1.0.0",
  "private": true,
  "description": "Contact-form backend for the Web Smith Studio website. Validates inquiries and delivers them as designed emails with Nodemailer.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "preview:emails": "node scripts/previewEmails.js",
    "send:test": "node scripts/sendTestEmail.js",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mailparser": "^3.14.3",
    "smtp-server": "^3.21.4"
  }
}
